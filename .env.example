NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_server_only_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_server_only_smtp_password
SMTP_SECURE=false
EMAIL_FROM=ADCI Learning Hub <updates@adcionline.com>
EMAIL_REPLY_TO=support@adcionline.com
CRON_SECRET=generate_a_long_random_server_only_secret
NEXT_PUBLIC_APP_URL=https://lms.adcionline.com

# Agora embedded live classroom. Keep the certificate server-only.
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_server_only_agora_app_certificate

# Zoom Live. Create a Server-to-Server OAuth app and a Meeting SDK app in Zoom Marketplace.
# Keep every value below server-only; never prefix these with NEXT_PUBLIC_.
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_API_CLIENT_ID=your_server_to_server_oauth_client_id
ZOOM_API_CLIENT_SECRET=your_server_to_server_oauth_client_secret
ZOOM_HOST_USER_ID=host_email_or_zoom_user_id
ZOOM_MEETING_SDK_CLIENT_ID=your_meeting_sdk_client_id
ZOOM_MEETING_SDK_CLIENT_SECRET=your_server_only_meeting_sdk_client_secret

# Cloudflare R2 (lesson video storage/delivery). Server-only: never prefix with NEXT_PUBLIC_.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_server_only_r2_secret_access_key
R2_BUCKET_NAME=adci-lesson-videos
