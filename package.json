{
  "name": "adci-learning-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:logic": "node scripts/check_logic_consistency.mjs",
    "test:zoom": "node scripts/check_zoom_registration.mjs",
    "test:session": "node scripts/check_session_guard.mjs",
    "test:database": "node scripts/test_zoom_access.mjs",
    "test:rate-limit": "node scripts/test_rate_limit.mjs",
    "test": "pnpm test:logic && pnpm test:zoom && pnpm test:session && pnpm test:database && pnpm test:rate-limit",
    "test:e2e": "playwright test",
    "check:release": "node scripts/check_release_readiness.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:release && pnpm build",
    "audit:production": "pnpm audit --prod --audit-level=moderate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@supabase/supabase-js": "2.115.0",
    "@zoom/meetingsdk": "6.2.0",
    "agora-rtc-sdk-ng": "4.24.8",
    "agora-token": "2.0.6",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-zoom": "npm:react@18.2.0",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.4",
    "typescript": "^5.7.2"
  }
}
